# MongoDB
MONGO_USER=ecelluser
MONGO_PASSWORD=ecellpass

# Backend
SECRET_KEY=your-secret-key-change-in-production-12345678901234567890
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
ADMIN_EMAIL=admin@ecell.com
ADMIN_PASSWORD_HASH=$2b$12$example_hash_here_bcrypt
ALLOWED_DOMAINS=klecba.edu.in,kle.ac.in,klecba.edu
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Scalability & Privacy
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379
LOG_USER_PII=false

# Frontend
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
